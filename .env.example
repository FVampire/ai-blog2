# Database Configuration
# Supported database types: postgresql (or postgres), mysql, sqlite, supabase
DATABASE_TYPE=postgresql
DATABASE_URL=postgresql://username:password@localhost:5432/blog_db
# For SQLite, you can use: DATABASE_URL=sqlite://./database.sqlite

# Supabase Configuration (if using DATABASE_TYPE=supabase)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
NEXT_PUBLIC_SUPABASE_DB_NAME=your_database_name

# JWT Secret (generate a random string for production)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# JWT Expiration (in seconds or zeit/ms format)
JWT_EXPIRES_IN=7d

# Node Environment
NODE_ENV=development

# Server Configuration
PORT=3000
