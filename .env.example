# Database Configuration
DATABASE_TYPE=postgresql
# Primary database: blog_db (posts + tags). Use direct 5432, not pooler blog_db on 6543.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/blog_db
DATABASE_SSL=true

# JWT Secret (generate a random string for production)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Node Environment
NODE_ENV=development

# Server Configuration
PORT=3000
SITE_URL=http://localhost:3000

# Agent API (for Cursor Agent one-click blog publishing)
AGENT_API_KEY=your-agent-api-key-change-this
AGENT_AUTHOR_ID=1

# IP geolocation (server-only; Amap Web Service API key)
AMAP_WEB_SERVICE_KEY=your-amap-web-service-key

# Admin translation tools (server-only)
TENCENTCLOUD_SECRET_ID=your-tencent-cloud-secret-id
TENCENTCLOUD_SECRET_KEY=your-tencent-cloud-secret-key
TENCENTCLOUD_HUNYUAN_TRANSLATION_MODEL=hunyuan-translation-lite
ALIBABA_CLOUD_ACCESS_KEY_ID=your-alibaba-cloud-access-key-id
ALIBABA_CLOUD_ACCESS_KEY_SECRET=your-alibaba-cloud-access-key-secret
BAIDU_TRANSLATE_APP_ID=your-baidu-translate-app-id
BAIDU_TRANSLATE_SECRET_KEY=your-baidu-translate-secret-key

# Deploy Webhook (for auto-deployment on git push)
DEPLOY_SECRET=your-deploy-secret-change-this
DEPLOY_BRANCH=master
DEPLOY_SCRIPT=scripts/deploy.sh

# Supabase Configuration (optional)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
NEXT_PUBLIC_SUPABASE_DB_NAME=your_database_name
