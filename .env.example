# Database Configuration
DATABASE_TYPE=postgresql
# Primary database: blog_db (posts + tags). Use direct 5432, not pooler blog_db on 6543.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/blog_db
DATABASE_SSL=true

# JWT Secret (generate a random string for production)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Node Environment
NODE_ENV=development

# Server Configuration
PORT=3000
SITE_URL=http://localhost:3000

# Agent API (for Cursor Agent one-click blog publishing)
AGENT_API_KEY=your-agent-api-key-change-this
AGENT_AUTHOR_ID=1

# Tencent Cloud COS (required for media; local and production share the same bucket)
COS_SECRET_ID=your-cos-secret-id
COS_SECRET_KEY=your-cos-secret-key
COS_BUCKET=your-bucket-appid
COS_REGION=ap-guangzhou
# Optional custom/CDN domain. Default: https://<bucket>.cos.<region>.myqcloud.com
# COS_PUBLIC_BASE_URL=https://img.example.com
# Object ACL. Use none if the bucket already has a public-read policy.
# COS_OBJECT_ACL=public-read

# IP geolocation (server-only; Amap Web Service API key)
AMAP_WEB_SERVICE_KEY=your-amap-web-service-key

# Admin translation tools (server-only)
TENCENTCLOUD_SECRET_ID=your-tencent-cloud-secret-id
TENCENTCLOUD_SECRET_KEY=your-tencent-cloud-secret-key
TENCENTCLOUD_HUNYUAN_TRANSLATION_MODEL=hunyuan-translation-lite
ALIBABA_CLOUD_ACCESS_KEY_ID=your-alibaba-cloud-access-key-id
ALIBABA_CLOUD_ACCESS_KEY_SECRET=your-alibaba-cloud-access-key-secret
BAIDU_TRANSLATE_APP_ID=your-baidu-translate-app-id
BAIDU_TRANSLATE_SECRET_KEY=your-baidu-translate-secret-key

# Gemini admin tool (server-only)
GEMINI_API_KEY=your-gemini-api-key
# Optional; defaults to gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-flash

# Deploy Webhook (for auto-deployment on git push)
DEPLOY_SECRET=your-deploy-secret-change-this
DEPLOY_BRANCH=master
DEPLOY_SCRIPT=scripts/deploy.sh

# Feishu comment notifications (custom bot webhook)
# FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxx
# FEISHU_WEBHOOK_SECRET=optional-sign-secret
# FEISHU_NOTIFY_COMMENTS=true

# Outbound publishing and distribution (server-only)
# Secrets and credential-bearing webhook URLs must stay in .env/process environment.
# INDEXNOW_KEY=your-indexnow-key
# DISTRIBUTE_WEBHOOK_URL=https://automation.example.com/hooks/blog-published
# TELEGRAM_BOT_TOKEN=your-telegram-bot-token
# TELEGRAM_CHAT_ID=your-chat-id
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
# WECHAT_APP_ID=your-wechat-official-account-app-id
# WECHAT_APP_SECRET=your-wechat-official-account-app-secret
# Leave false to create a draft only. Requires the account's free-publish permission when true.
# WECHAT_AUTO_PUBLISH=false
# BILIBILI_WEBHOOK_URL=https://automation.example.com/hooks/bilibili
# XIAOHONGSHU_WEBHOOK_URL=https://automation.example.com/hooks/xiaohongshu
# DOUYIN_WEBHOOK_URL=https://automation.example.com/hooks/douyin

# Supabase Configuration (optional)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
NEXT_PUBLIC_SUPABASE_DB_NAME=your_database_name
