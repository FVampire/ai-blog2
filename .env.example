# Database Configuration
DATABASE_TYPE=postgresql
DATABASE_URL=postgresql://blog:blog_password@localhost:5432/blog_db
# Set to true for cloud databases requiring SSL
DATABASE_SSL=false

# JWT Secret (generate a random string for production)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Node Environment
NODE_ENV=development

# Server Configuration
PORT=3000
SITE_URL=http://localhost:3000

# Agent API (for Cursor Agent one-click blog publishing)
AGENT_API_KEY=your-agent-api-key-change-this
AGENT_AUTHOR_ID=1

# Deploy Webhook (for auto-deployment on git push)
DEPLOY_SECRET=your-deploy-secret-change-this
DEPLOY_BRANCH=main
DEPLOY_SCRIPT=scripts/deploy.sh

# Supabase Configuration (optional)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
NEXT_PUBLIC_SUPABASE_DB_NAME=your_database_name
